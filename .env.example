# Copy to `.env` and fill in. `lib/config/config.ts` validates each value the
# first time it is read, naming what is missing — so a build or a boot does not
# require secrets it never uses, and a genuinely absent one fails loudly at the
# point of use rather than being satisfied by a placeholder.

# --- Database (required) ---
DATABASE_URL=postgres://user:password@localhost:5432/vpf
# Required whenever Vitest runs; the config swaps DATABASE_URL for it automatically.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/vpf_test

# --- Redis cache (optional) ---
# Server-only, read directly from process.env. When unset the app still runs and
# serves every request from the database.
# Cached meets, records and results expire after a day; scripts/warm-cache.sh
# re-populates them from cron. No particular eviction policy is required.
# Under docker compose this is `redis://redis:6379` (the service name).
REDIS_URL=redis://localhost:6379
# Local development escape hatch: bypass the cache entirely.
CACHE_DISABLED=false

# --- Auth (required) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# --- Email ---
# Local development: skip verification emails entirely. Never set in production —
# it also marks new registrations verified immediately.
EMAIL_VERIFICATION_SKIP=true
# Required unless EMAIL_VERIFICATION_SKIP=true.
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_SECURE=false

# --- Cloudflare R2, VIP image uploads (all five required) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_VIP_BUCKET=
CLOUDFLARE_R2_VIP_PUBLIC_URL_BASE=

# --- Bank transfer QR (https://vietqr.app) ---
# Default to empty and produce a broken QR URL rather than throwing.
# BANK_NAME is the bank's name (e.g. "VietinBank"), not a NAPAS BIN.
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
